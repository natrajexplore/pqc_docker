# Copy to .env with `make secrets` (it fills the secrets for you).
# .env is gitignored. Every value here is LAB ONLY.

# UI port, published on 127.0.0.1 only.
PQCW_UI_PORT=8080

# IKEv2 PSK and RFC 8784 PPK (hex, 32 bytes). Generated by scripts/gen-lab-secrets.sh.
PQCW_IKE_PSK=
PQCW_IKE_PPK_HEX=

# Shared token the backend presents to every capture agent (X-PQCW-Token).
PQCW_AGENT_TOKEN=

# Branch or TAG of the experimental strongSwan ml-dsa work. Upstream's Dockerfile.mldsa
# uses `git clone --branch`, which rejects commit hashes, so this cannot be pinned to a
# commit without forking it. Last known-good build: ml-dsa @ eb72966d2211141c73d4f66e4825c406a0811c3e
# (strongSwan 6.1.0, 2026-10-29). If a rebuild breaks, compare against that commit.
PQCW_STRONGSWAN_MLDSA_REF=ml-dsa

# Backend behaviour
PQCW_LOG_LEVEL=INFO
# text (human) or json (one object per line, for Loki/ELK/etc.). Lines carry a request id.
PQCW_LOG_FORMAT=text
# Host names the UI is reached by; requests with any other Host or a cross-site
# Origin are rejected (DNS-rebinding / CSRF guard). Add yours behind a reverse proxy.
PQCW_ALLOWED_HOSTS=127.0.0.1,localhost,::1
# Allow the UI's "decrypt with key log" toggle for TLS/SSH-less scenarios (lab only).
PQCW_ALLOW_TLS_KEYLOG=true
# Max seconds a single scenario may run before it is aborted.
PQCW_RUN_TIMEOUT_S=120
